{
  "manifest_version": 3,
  "name": "Compose Assist",
  "version": "0.1.0",
  "description": "Draft or refine a reply in place from the text written above the quote.",
  "browser_specific_settings": {
    "gecko": { "id": "compose-assist@personal.invalid", "strict_min_version": "158.0" }
  },
  "permissions": ["compose", "scripting", "storage", "messagesRead"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "scripts": ["extensions/compose/background.js"] },
  "compose_action": { "default_title": "Compose Assist" },
  "commands": {
    "compose-assist": { "suggested_key": { "default": "Ctrl+Alt+C" }, "description": "Draft or refine reply in place" }
  },
  "options_ui": { "page": "shared/options.html", "open_in_tab": true }
}
